PORT=3000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=dating_app
JWT_SECRET=change-this-to-a-long-random-string
BASE_URL=http://localhost:3000
# Profile photo storage (Railway: mount volume at /app/uploads and set UPLOAD_DIR=/app/uploads)
# UPLOAD_DIR=
SUBSCRIPTIONS_ENABLED=true
OTP_TTL_MINUTES=5

# Resend email (password reset) — https://resend.com/docs/send-with-nodejs
# Replace re_xxxxxxxxx with your real key from https://resend.com/api-keys
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_xxxxxxxxx
PASSWORD_RESET_EMAIL_FROM=onboarding@resend.dev
PASSWORD_RESET_EMAIL_FROM_NAME=Spark Dating

# Bird email (optional fallback) — https://bird.com/en-us/docs/guides/email/sending-email
# EMAIL_PROVIDER=bird
BIRD_WORKSPACE_ID=ws_01kwy5m1she1m8a1jm5g7dmqf8
BIRD_API_KEY=

# Tmailor test inbox (optional — for reading reset codes at devflow@tokmail.net)
TEMPMAIL_EMAIL=devflow@tokmail.net
TEMPMAIL_ACCESS_TOKEN=
TEMPMAIL_INBOX_URL=

# Africa's Talking SMS (phone sign-in OTP)
SMS_PROVIDER=africas_talking
AFRICAS_TALKING_USERNAME=devflow@tokmail.net
AFRICAS_TALKING_API_KEY=
AFRICAS_TALKING_SENDER_ID=Spark

# Mobile money subscriptions — see PESAPAL_SETUP.md (default) or MTN_MOMO_SETUP.md (direct popup)
# MOBILE_MONEY_PROVIDER=pesapal
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_SANDBOX=false
PESAPAL_CURRENCY=UGX
PESAPAL_COUNTRY_CODE=UG
PESAPAL_IPN_ID=
MOBILE_MONEY_SIMULATE=false

# Flutterwave OAuth (optional alternative)
FLUTTERWAVE_CLIENT_ID=
FLUTTERWAVE_CLIENT_SECRET=
FLUTTERWAVE_SANDBOX=true
FLUTTERWAVE_CURRENCY=UGX
# FLUTTERWAVE_DEFAULT_NETWORK=MTN
# Legacy static secret key (optional fallback):
# FLUTTERWAVE_SECRET_KEY=

# MTN MoMo direct (alternative) — see MTN_MOMO_SETUP.md, npm run momo:setup
# MOBILE_MONEY_PROVIDER=mtn
# MTN_MOMO_SUBSCRIPTION_KEY=
# MTN_MOMO_API_USER=
# MTN_MOMO_API_KEY=
# MTN_MOMO_ENV=sandbox
# MTN_MOMO_TARGET_ENV=sandbox
# MTN_MOMO_CURRENCY=EUR
# MTN_MOMO_USE_PREAPPROVAL=false
# MTN_MOMO_SANDBOX_AMOUNT=1
# MTN_MOMO_CALLBACK_URL=

# Africa's Talking Mobile Checkout (alternative)
AFRICAS_TALKING_PAYMENT_PRODUCT_NAME=
AFRICAS_TALKING_CURRENCY_CODE=UGX
# AFRICAS_TALKING_PAYMENTS_SANDBOX=true
# AFRICAS_TALKING_PROVIDER_CHANNEL=MTNUG

# Termii email OTP (optional alternative) — https://developers.termii.com/email-token
# EMAIL_PROVIDER=termii
# TERMII_API_KEY=
# TERMII_BASE_URL=https://api.ng.termii.com
# TERMII_EMAIL_CONFIG_ID=

# Local dev only: show OTP in API response when email/SMS delivery is unavailable
# EXPOSE_OTP=true

# Bird SMS — https://bird.com/dashboard (access keys start with bk_eu1_)
# SMS_PROVIDER=bird
# BIRD_WORKSPACE_ID=ws_01kwy5m1she1m8a1jm5g7dmqf8
# BIRD_API_KEY=
# BIRD_NAVIGATOR_ID=
# BIRD_CHANNEL_ID=
